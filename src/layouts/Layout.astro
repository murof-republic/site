---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Murof',
	description = 'Unimos entusiastas e profissionais de programação, tecnologia, jogos e arte em um ambiente feito para a troca de conhecimento e boas conexões. Faça parte!'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL('/banner.webp', Astro.site).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': 'https://murof.me/#organization',
			name: 'Murof',
			url: 'https://murof.me/',
			logo: socialImage,
			description
		},
		{
			'@type': 'WebSite',
			'@id': 'https://murof.me/#website',
			url: 'https://murof.me/',
			name: 'Murof',
			description,
			publisher: { '@id': 'https://murof.me/#organization' },
			inLanguage: 'pt-BR'
		}
	]
};
---

<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>

		<meta name="description" content={description} />
		<meta name="author" content="triggwer" />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#000000" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />

		<link rel="canonical" href={canonical} />

		<!-- Favicon -->
		<link rel="icon" type="image/ico" href="/favicon.ico" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="Murof" />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content="Murof, comunidade de tecnologia, jogos e arte" />
		<meta property="og:image:type" content="image/webp" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@murof" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content="Murof, comunidade de tecnologia, jogos e arte" />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<!-- Fonte -->
		<link rel="preconnect" href="https://rsms.me/" />
		<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

		<meta name="generator" content={Astro.generator} />

		<ClientRouter />
	</head>

	<body>
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>