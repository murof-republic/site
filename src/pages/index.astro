---
import "../styles/global.css"
import "../styles/index.css"

import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Tittle from "../components/Tittle.astro";
import background from "../assets/images/background.webp"

import { buscarApoiadores } from "../firebase/apoiadores"

const apoiadores = await buscarApoiadores();
const trigger = apoiadores.find(
    (apoiador) => apoiador.id === "1369726597162205317"
)!

const snuf = apoiadores.find(
    (apoiador) => apoiador.id === "1370119246276726944"
)!
---

<Layout title="Home">
	<main>
		<article>
			<section class="introduction" style={`background-image: url(${background.src})`}>
				<div class="introduction-text">
					<img src={background.src} class="background-mobile" alt="Murof cat!">
					<h1>Olá Viajante!</h1>
					<p>Unimos entusiastas e profissionais de programação, tecnologia, jogos e arte em um ambiente feito para a troca de conhecimento e boas conexões. Faça parte!</p>
					
					<span>@murof-republic, by triggerww</span>
				</div>

				<div class="introduction-cards">
					<Card
						class="fixed"
						avatar={trigger.avatar}
						nome={trigger.nome}
						descricao={"Acesse nosso repositório e organização no GitHub! Confira nossos projetos e wallpapers da comunidade."}
						link="https://github.com/murof-republic"
					/>

					<Card
						class="fixed"
						avatar={snuf.avatar}
						nome={snuf.nome}
						descricao={"Tenha ferramentas para administração, interação e entretenimento, tudo em um só lugar."}
						link="https://discord.com/discovery/applications/1370119246276726944"			
					/>
				</div>
			</section>
		</article>
	</main>
</Layout>



