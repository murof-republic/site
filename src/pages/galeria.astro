---
import "../styles/global.css"
import Layout from "../layouts/Layout.astro"
import Tittle from "../components/Tittle.astro"
import Arte from "../components/Arte.astro"
import Card from "../components/Card.astro"

import { buscarArtes } from "../firebase/artes"
import { buscarArtistas } from "../firebase/apoiadores.ts"

const artes = await buscarArtes()
const artistas = await buscarArtistas()
---

<Layout title="Galeria">
    <main>
        <article>
            <Tittle
                titulo="Galeria de Artes"
                subtitulo="Todos as artes aqui foram feitas pela galera do servidor!"
            />

            <section class="galeria">
                {artes.map(arte => (
                    <Arte
                        arte={arte.url}
                        nome={arte.nome}
                        autor={arte.autor}
                    />
                ))}
            </section>

            <Tittle
                titulo="Artistas"
                subtitulo="Espaço dedicado aos créditos de todos os artistas. Muito obrigado por contribuírem e fazerem parte deste mural!"
            />

            <section class="artistas">
                {artistas.map(artista => (
                    <Card 
                        avatar={artista.avatar}
                        nome={artista.nome}
                        descricao={artista.descrição}
                    />
                ))}
            </section>
        </article>
    </main>

    <div class="modal" id="Modal">
        <img class="modal-content" id="img" src="" alt="">
    </div>

    <script>
        const modal = document.getElementById("Modal") as HTMLDivElement
        const modalImg = document.getElementById("img") as HTMLImageElement

        const imagens = document.querySelectorAll<HTMLImageElement>(
            ".galeria img"
        )

        function openModal(img: HTMLImageElement) {
            modalImg.src = img.src
            modalImg.alt = img.alt

            modal.style.display = "flex"
            document.body.style.overflow = "hidden"

            setTimeout(() => {
                modal.classList.add("show")
                modalImg.classList.add("show")
            }, 10)
        }

        function closeModal(event: MouseEvent) {
            if (
                event.target !== modal &&
                event.target !== modalImg
            ) {
                return
            }

            modal.classList.remove("show")
            modalImg.classList.remove("show")

            setTimeout(() => {
                modal.style.display = "none"
                document.body.style.overflow = ""
            }, 500)
        }

        imagens.forEach((img) => {
            img.addEventListener("click", () => {
                openModal(img)
            })
        })

        modal.addEventListener("click", closeModal)
    </script>

    <style>
        .galeria {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 20px;
            width: 100%;
            font-size: 1rem;
            padding-bottom: 4%;
            border-bottom: 1px solid var(--border);
        }

        .artistas {
            display: flex;
            flex-direction: row;
            align-items: stretch;
            justify-content: flex-start;
            flex-wrap: wrap;
            font-size: 1rem;
            gap: 20px;
            margin-bottom: 5%;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(10px);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 1000;
        }

        .modal-content {
            margin: auto;
            display: block;
            position: relative;
            max-width: 80%;
            max-height: 80%;
            transform: scale(0.7);
            transition: transform 0.5s ease;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .modal.show {
            opacity: 1;
        }

        .modal-content.show {
            transform: scale(1);
        }

        @media (max-width: 767px) {
            .galeria {
                display: flex;
                flex-direction: column;
            }

            .artistas {
                flex-direction: column;
                margin: 0;
                margin-bottom: 15%;
            }
        }
    </style>
</Layout>