---
import Layout from "../layouts/Layout.astro"
import { buscarApoiadores } from '../firebase/apoiadores'

const apoiadores = await buscarApoiadores()
---

<Layout title="Galeria">
    <h1>Apoiadores</h1>

    {apoiadores.map((apoiador) => (
        <div>
            <h2>{apoiador.nome}</h2>
            <p>{apoiador.descrição}</p>
            <img src={apoiador.avatar} alt={apoiador.nome} width="100" />
            <p>Artista: {apoiador.artista ? 'Sim' : 'Não'}</p>
        </div>
    ))}
</Layout>