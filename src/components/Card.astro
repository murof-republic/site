---
interface Props {
    avatar: string
    nome: string
    descricao: string
    class?: string;
    link?: string;
}

const { avatar, nome, descricao, class: className, link } = Astro.props
---

<div class={`card ${className ?? ""}`} onclick={link ? `window.open('${link}', '_blank')` : undefined}>
    <img src={avatar} alt={nome}>

    <div class="card-content">
        <h2>{nome}</h2>
        <p>{descricao}</p>
    </div>
</div>

<style>
    .card:global(.fixed) {
        width: 100%;
        margin-block: 5%;
    }

    .card {
        background-color: var(--background);
        border: 1px solid var(--border);
        padding: 20px;
        transition: all 0.2s ease-out;
        width: calc(33.333% - 14px);
        height: 200px;
    }

    .card:hover {
        transform: scale(1.05);
        transition: all 0.2s ease-out;
        border: 1px solid var(--principal);
        cursor: pointer;
    }

    .card img {
        width: 60px;
        padding-bottom: 5px;
    }

    .card-content {
        font-size: 1rem;
    }

    .card-content p {
        padding-top: 2px;
    }

    @media (max-width: 767px) {
        .card {
            margin: 0;
            font-size: 0.9rem;
            width: 100%;
        }

        .card img {
            width: 50px;
            padding-bottom: 5px;
        }
        
        .card-content h2{
            font-size: 1.2rem;
        }

        .card:hover {
            transform: none;
            transition: none;
            border: 1px solid var(--border);
        }

        .card:global(.fixed) {
            margin: 0;
            margin-top: 5%;
        }
    }
</style>