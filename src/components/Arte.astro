---
interface Props {
    arte: string
    nome: string
    autor: string
}

const { arte, nome, autor } = Astro.props
---

<div class="card">
    <img src={arte} alt={nome} data-modal-image>

    <div class="overlay">
        <h4>{nome}</h4>
        <p>{autor}</p>
    </div>
</div>

<style>
    .card {
        position: relative;
        width: 100%;
        min-height: fit-content;
        background-color: var(--background);
        border: 1px solid var(--border);
        overflow: hidden;
        transition: all 0.2s ease-out;
    }

    .card img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .card:hover img {
        transform: scale(1.1);
        cursor: pointer;
    }

    .overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 16px;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.85), rgba(0, 0, 0, 0));
        width: 100%;
        color: white;
        text-align: center;
        cursor: pointer;
        z-index: 997;
    }

    @media (max-width: 1000px) {
        .card {
            height: 300px;
        }

        .card:hover img {
            transform: none;
        }
    }
</style>