---
interface Props {
    nome: string
    descricao: string
    mantedor: string
    class?: string;
    link?: string;
}

const { nome, descricao, mantedor, link, class: className } = Astro.props
---

<div class={`card ${className ?? ""}`} onclick={link ? `window.open('${link}', '_blank')` : undefined} >
    <div class="card-content">
        <h2>{nome}</h2>
        <p>{descricao}</p><br>
        <p>Mantido por {mantedor}</p>
    </div>
</div>

<style>
    .card {
        background-color: var(--background);
        border: 1px solid var(--border);
        padding: 20px;
        transition: all 0.2s ease-out;
        width: calc(33.333% - 14px);
        min-height: 200px;
        height: auto;
        box-sizing: border-box;
    }

    .card-content {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .card-content h2,
    .card-content p {
        overflow-wrap: anywhere;
    }

    .card:hover {
        transform: scale(1.05);
        transition: all 0.2s ease-out;
        border: 1px solid var(--principal);
        cursor: pointer;
    }

    .card-content {
        width: 100%;
        text-align: center;
    }

    .card-content h2 {
        font-size: 1.2rem;
        padding: 5px;
    }

    .card-content p {
        padding-top: 2px;
    }

    @media (max-width: 1000px) {
        .card {
            margin: 0;
            font-size: 0.9rem;
            width: 100%;
        }

        .card img {
            width: 50px;
            padding-bottom: 5px;
        }
        
        .card-content h2{
            font-size: 1.2rem;
        }

        .card:hover {
            transform: none;
            transition: none;
            border: 1px solid var(--border);
        }
    }
</style>