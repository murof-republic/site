---
import "../styles/global.css"
import "./Navbar.css"
import discord from "../assets/images/discord.png"
import github from "../assets/images/github.png"

const page = Astro.url.pathname;
---

<nav>
    <div class="left">
        <a href="/" class="logo">Murof</a>
    </div>

    <div class="center">
        <a href="/" data-astro-prefetch class={page === "/" ? "active" : ""}>Home</a>
        <a href="/loja" data-astro-prefetch class={page === "/loja" ? "active" : ""}>Loja</a>
        <a href="/galeria" data-astro-prefetch class={page === "/galeria" ? "active" : ""}>Galeria</a>
        <a href="/projetos" data-astro-prefetch class={page === "/projetos" ? "active" : ""}>Projetos</a>
        <a href="/apoiadores" data-astro-prefetch class={page === "/apoiadores" ? "active" : ""}>Apoiadores</a>
    </div>

    <div class="right">
        <div class="btn">
            <a href="https://discord.gg/MWrYrytMCg" target="_blank">
                <img src={discord.src} alt="Discord" class="btn-social">
            </a>

            <a href="https://github.com/murof-republic" target="_blank">
                <img src={github.src} alt="Github" class="btn-social">
            </a>
        </div>

        <div class="widget-mine">
            <span id="dot" class="offline"></span>
            <span id="adress">mc.murof.me</span>
        </div>
    </div>

    <details class="mobile-menu">
        <summary>
            <span class="menu-icon">☰</span>
        </summary>

        <div class="dropdown">
            <a href="/" data-astro-prefetch class={page === "/" ? "active" : ""}>Home</a>
            <a href="/loja" data-astro-prefetch class={page === "/loja" ? "active" : ""}>Loja</a>
            <a href="/galeria" data-astro-prefetch class={page === "/galeria" ? "active" : ""}>Galeria</a>
            <a href="/projetos" data-astro-prefetch class={page === "/projetos" ? "active" : ""}>Projetos</a>
            <a href="/apoiadores" data-astro-prefetch class={page === "/apoiadores" ? "active" : ""}>Apoiadores</a>

            <div class="mobile-social">
                <a href="https://discord.gg/MWrYrytMCg" target="_blank">
                    Discord
                </a>

                <a href="https://github.com/murof-republic" target="_blank">
                    GitHub
                </a>
            </div>
        </div>
    </details>
</nav>

<script>
    function updateActive(): void {
        const path = window.location.pathname.replace(/\/$/, "") || "/";

        document.querySelectorAll<HTMLAnchorElement>(
            ".center > a, .dropdown > a"
        ).forEach((link) => {
            const href = link.getAttribute("href")?.replace(/\/$/, "") || "/";

            link.classList.toggle("active", href === path);
        });
    }

    updateActive();

    document.addEventListener("astro:page-load", updateActive);

    const statusStorageKey = "murof-minecraft-status";

    function setServerStatus(online: boolean, host = "mc.murof.me"): void {
        const dot = document.getElementById("dot") as HTMLElement | null;
        const adress = document.getElementById("adress") as HTMLElement | null;

        dot?.classList.toggle("online", online);
        dot?.classList.toggle("offline", !online);

        if (adress) {
            adress.innerText = host;
        }
    }

    function readCachedStatus(): void {
        try {
            const cached = JSON.parse(sessionStorage.getItem(statusStorageKey) ?? "null");

            if (cached && typeof cached.online === "boolean") {
                setServerStatus(cached.online, cached.host);
            }
        } catch {
            sessionStorage.removeItem(statusStorageKey);
        }
    }

    async function updateServerStatus(): Promise<void> {
        readCachedStatus();

        try {
            const response = await fetch(
                "https://api.mcstatus.io/v2/status/java/mc.murof.me",
                { cache: "no-store" }
            );

            if (!response.ok) {
                throw new Error(`Status API returned ${response.status}`);
            }

            const data = await response.json();
            const versionName = data.version?.name_clean ?? "";
            const online = data.online === true && !/offline/i.test(versionName);
            const status = { online, host: data.host ?? "mc.murof.me" };

            setServerStatus(status.online, status.host);
            sessionStorage.setItem(statusStorageKey, JSON.stringify(status));
        } catch {
            setServerStatus(false);
            sessionStorage.setItem(
                statusStorageKey,
                JSON.stringify({ online: false, host: "mc.murof.me" })
            );
        }
    }

    updateServerStatus();
    document.addEventListener("astro:page-load", updateServerStatus);

    // Menu Dropdown; Animação.
    const mobileMenu = document.querySelector(".mobile-menu") as HTMLDetailsElement;

    mobileMenu?.addEventListener("click", (event: MouseEvent) => {
        const target = event.target as HTMLElement;

        if (target.closest("summary") && mobileMenu.open) {
            event.preventDefault();

            mobileMenu.classList.add("closing");

            setTimeout(() => {
                mobileMenu.open = false;
                mobileMenu.classList.remove("closing");
            }, 200);
        }
    });
</script>