---
import "../styles/global.css"
import "./Navbar.css"
import discord from "../assets/images/discord.png"
import github from "../assets/images/github.png"

const page = Astro.url.pathname;
---

<nav>
    <div class="left">
        <a href="/" class="logo">Murof</a>
    </div>

    <div class="center">
        <a href="/" class={page === "/" ? "active" : ""}>Home</a>
        <a href="/loja" class={page === "/loja" ? "active" : ""}>Loja</a>
        <a href="/galeria" class={page === "/galeria" ? "active" : ""}>Galeria</a>
        <a href="/projetos" class={page === "/projetos" ? "active" : ""}>Projetos</a>
    </div>

    <div class="right">
        <div class="btn">
            <a href="https://discord.gg/MWrYrytMCg" target="_blank">
                <img src={discord.src} alt="Discord" class="btn-social">
            </a>

            <a href="https://github.com/murof-republic" target="_blank">
                <img src={github.src} alt="Github" class="btn-social">
            </a>
        </div>

        <div class="widget-mine">
            <span id="dot" class="offline"></span>
            <span id="adress">mc.murof.me</span>
        </div>
    </div>

    <details class="mobile-menu">
        <summary>
            <span class="menu-icon">☰</span>
        </summary>

        <div class="dropdown">
            <a href="/" class={page === "/" ? "active" : ""}>Home</a>
            <a href="/loja" class={page === "/loja" ? "active" : ""}>Loja</a>
            <a href="/galeria" class={page === "/galeria" ? "active" : ""}>Galeria</a>
            <a href="/projetos" class={page === "/projetos" ? "active" : ""}>Projetos</a>

            <div class="mobile-social">
                <a href="https://discord.gg/MWrYrytMCg" target="_blank">
                    Discord
                </a>

                <a href="https://github.com/murof-republic" target="_blank">
                    GitHub
                </a>
            </div>
        </div>
    </details>
</nav>

<script>
    function updateActive(): void {
        const path: string = window.location.pathname.replace(/\/$/, "") || "/";

        document.querySelectorAll<HTMLAnchorElement>(".dropdown > a").forEach((link) => {
            link.classList.toggle("active", link.getAttribute("href") === path);
        });
    }

    updateActive();

    document.addEventListener("astro:page-load", updateActive);


    fetch("https://api.mcstatus.io/v2/status/java/mc.murof.me")
        .then(response => response.json())
        .then(data => {
            if (data.online) {
                const dot = document.getElementById("dot") as HTMLElement;
                const adress = document.getElementById("adress") as HTMLElement;

                dot.classList.remove("offline");
                dot.classList.add("online");
                adress.innerText = data.host;
            }
        });


    // Menu Dropdown; Animação.
    const mobileMenu = document.querySelector(".mobile-menu") as HTMLDetailsElement;

    mobileMenu?.addEventListener("click", (event: MouseEvent) => {
        const target = event.target as HTMLElement;

        if (target.closest("summary") && mobileMenu.open) {
            event.preventDefault();

            mobileMenu.classList.add("closing");

            setTimeout(() => {
                mobileMenu.open = false;
                mobileMenu.classList.remove("closing");
            }, 200);
        }
    });
</script>